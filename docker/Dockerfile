# Build environment for echoroot.
#
# Ubuntu 18.04 is deliberate: it is the newest release whose glibc (2.27) still
# builds the host tools of Buildroot 2017.05 unpatched, and it ships the gcc-7
# ARM cross compiler that u-boot 2010.06 needs.
#
# comerr-dev provides /usr/bin/compile_et. The pinned Buildroot expects to find
# it on the build machine when building samba4 (its host-e2fsprogs dependency
# was removed in the fork); without it samba4 tries to run an ARM compile_et.
FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        comerr-dev \
        gcc-7-arm-linux-gnueabihf \
        binutils-arm-linux-gnueabihf \
        bc \
        bzip2 \
        ca-certificates \
        cpio \
        dosfstools \
        curl \
        e2fsprogs \
        fakeroot \
        file \
        genext2fs \
        git \
        libncurses5-dev \
        mtools \
        patch \
        perl \
        python \
        rsync \
        texinfo \
        unzip \
        wget \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Build as the invoking user so that files in the bind-mounted tree keep the
# host user's ownership. The image content is still root-owned: sdcard/Makefile
# creates the filesystem under fakeroot.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} build && useradd -m -u ${UID} -g ${GID} build
USER build

# u-boot/Makefile has "CROSS_COMPILE ?=" and appends "gcc-7" itself.
# Buildroot unexports CROSS_COMPILE, so this does not leak into the rootfs build.
ENV CROSS_COMPILE=arm-linux-gnueabihf-

# rootfs/br2echo/Makefile (generated by Buildroot, committed upstream) hardcodes
# this path, so the tree has to be mounted here.
WORKDIR /sata/src/echoroot
